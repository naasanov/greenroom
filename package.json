{
  "name": "greenroom",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @greenroom/db generate",
    "db:migrate": "pnpm --filter @greenroom/db migrate",
    "db:seed": "turbo run build --filter=@greenroom/db && pnpm --filter @greenroom/db seed",
    "test:e2e": "turbo run test:e2e",
    "deploy:staging": "fly deploy . --config infra/fly/staging.api.toml --dockerfile apps/api/Dockerfile --remote-only && fly deploy . --config infra/fly/staging.web.toml --dockerfile apps/web/Dockerfile --remote-only"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^6.0.2"
  }
}
