DATABASE_URL=postgres://greenroom:greenroom@localhost:5432/greenroom
TEST_DATABASE_URL=postgres://greenroom:greenroom@localhost:5432/greenroom_test
API_PORT=4000
# Optional override; the web app derives the API URL from its own host by default.
# NEXT_PUBLIC_API_URL=http://localhost:4000
INTEGRATIONS_MODE=fake
WEB_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
SESSION_COOKIE_NAME=gr_session
COOKIE_DOMAIN=
# Base64 of 32 random bytes (openssl rand -base64 32); encrypts stored OAuth tokens.
OAUTH_TOKEN_KEY=

# Only needed when INTEGRATIONS_MODE=real.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
# YouTube Data API v3 key; without it YouTube songs get no auto duration.
YOUTUBE_API_KEY=
# Resend API key (Sending access, domain greenroom.fyi). Magic-link sign-in fails in real mode without it.
RESEND_API_KEY=
# Optional From address on a verified Resend domain.
EMAIL_FROM=Greenroom <login@greenroom.fyi>
# Fine-grained PAT with Issues write on GITHUB_FEEDBACK_REPO. Without it POST /feedback returns 503 FEEDBACK_NOT_CONFIGURED in real mode.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=naasanov/greenroom
# Domain of the per-event calendar invite reply address (rsvp+<token>@domain). Must receive mail via Resend inbound before replies work.
EMAIL_REPLY_DOMAIN=greenroom.fyi
# Optional HMAC secret for reply tokens; falls back to OAUTH_TOKEN_KEY.
INVITE_TOKEN_SECRET=
# Resend inbound webhook signing secret (whsec_..., from the webhook's details page). Without it the
# inbound endpoint rejects every request, so calendar replies are not applied.
RESEND_WEBHOOK_SECRET=
