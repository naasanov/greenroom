DATABASE_URL=postgres://greenroom:greenroom@localhost:5432/greenroom
TEST_DATABASE_URL=postgres://greenroom:greenroom@localhost:5432/greenroom_test
API_PORT=4000
# Optional override; the web app derives the API URL from its own host by default.
# NEXT_PUBLIC_API_URL=http://localhost:4000
INTEGRATIONS_MODE=fake
WEB_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
SESSION_COOKIE_NAME=gr_session
COOKIE_DOMAIN=
# Base64 of 32 random bytes (openssl rand -base64 32); encrypts stored OAuth tokens.
OAUTH_TOKEN_KEY=

# Only needed when INTEGRATIONS_MODE=real.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
